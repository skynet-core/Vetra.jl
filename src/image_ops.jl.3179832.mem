        -             d[i + 2] = UInt8(((255 - Int(d[i + 2])) * ia + 127) ÷ 255)
        -             d[i + 3] = UInt8(((255 - Int(d[i + 3])) * ia + 127) ÷ 255)
        -         end
        -         d[i + 4] = UInt8(ia)
