        - """Largest partition entry count (upstream `maxEntryCount`)."""
        - function maxEntryCount(parts::Vector{Partition})
        -     m = 0
        -     for p in parts
        -         m = max(m, length(p.entries))
        -     end
        -     return m
        - end
