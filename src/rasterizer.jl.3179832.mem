        - # ---- 24.8 fixed point (upstream `Fixed32`) -------------------------------
        - 
        - fixed32(f::Float32) = Int32(trunc(f * 256f0)) # float->int32 cast truncates (Nim cast)
        - 
        - fixedInteger(p::Integer) = p ÷ 256
        - 
        - fixedTrunc(p::Integer) = (p ÷ 256) * 256
