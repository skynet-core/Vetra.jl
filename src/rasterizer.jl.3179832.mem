        0                 part.twoNonintersectingSpanningSegments = true
        -                 # Keep entry[1] on the left
        0                 if midpointX(e0) > midpointX(e1)
        0                     part.entries[1], part.entries[2] =
        -                         part.entries[2], part.entries[1]
        -                 end
        -             end
        -         end
        0     end
        0     return parts
        - end
