        0     end
        0     parts[1].top = top
        0     parts[1].bottom = top + partitionHeight
        0     for i in 2:numPartitions
        0         parts[i].top = parts[i - 1].bottom
        0         parts[i].bottom = parts[i - 1].bottom + partitionHeight
        0     end
