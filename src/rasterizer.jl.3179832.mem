        - function shapesToSegments(shapes::Vector{Vector{Vec2}}, skipHorizontal::Bool)
     3200     out = Vector{SegW}()
        0     for poly in shapes
        0         isempty(poly) && continue
        0         prev = quantizeY(poly[end])
        0         for (k, v) in enumerate(poly)
        0             cur = quantizeY(v)
        0             if k == 1 && prev == cur
        -                 continue # the closing point duplicates the start
        -             end
        0             seg = Segment(prev, cur)
        -             prev = cur
        0             if skipHorizontal && seg.at.y == seg.to.y
        -                 continue
        -             end
        -             winding = Int16(1)
        0             if seg.at.y > seg.to.y
        0                 seg = Segment(seg.to, seg.at)
        -                 winding = Int16(-1)
        -             end
        0             push!(out, SegW(seg, winding))
        0         end
        0     end
        0     return out
        - end
