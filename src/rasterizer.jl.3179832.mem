        0         if length(part.entries) == 2
        0             e0 = part.entries[1].segment
        0             e1 = part.entries[2].segment
        0             if !intersectsInsideSeg(e0, e1) &&
        -                 e0.at.y <= topF && e0.to.y >= botF &&
        -                 e1.at.y <= topF && e1.to.y >= botF
