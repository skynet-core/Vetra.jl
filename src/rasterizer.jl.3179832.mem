        -     i = 1
        -     count = 0
        -     prevAt = Int32(0)
        0     while i <= numHits
        0         h = hits[i]
        0         if h.at > 0
        0             if shouldFill(rule, count)
        0                 if i < numHits
        0                     nxt = hits[i + 1]
        -                     # Canceling touches are skipped here; the span will be
        -                     # yielded later as one larger chunk.
        0                     if nxt.at == h.at && h.winding + nxt.winding == 0
        0                         i += 2
        -                         continue
        -                     end
        -                     # Only the stop-fill (or last hit) matters in NonZero.
        0                     if rule === NonZero && count + h.winding != 0
        0                         count += h.winding
        0                         i += 1
        -                         continue
        -                     end
        -                 end
        0                 push!(out, (prevAt, h.at, count))
        -             end
        0             prevAt = h.at
        -         end
        0         count += h.winding
        0         i += 1
        0     end
        0     return out
        - end
