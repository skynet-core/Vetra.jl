        - """Stable insertion sort of hit x positions (upstream `sortHits`)."""
        - function sortHits!(hits::Vector{Hit}, len::Int)
        0     for i in 2:len
        0         j = i - 1
        -         k = i
        0         while j >= 1 && hits[j].at > hits[k].at
        0             tmp = hits[j + 1]
        0             hits[j + 1] = hits[j]
        0             hits[j] = tmp
        0             j -= 1
        0             k -= 1
        -         end
        0     end
        0     return nothing
        - end
