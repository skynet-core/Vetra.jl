        - # ---------- paths (T004) ----------
        - # Upstream: pixie/paths.nim -- WindingRule, Path (commands seq[float32] with
        - # PathCommandKind encoded inline, plus start/at Vec2), newPath, copy,
        - # parsePath, transform, addPath, closePath, moveTo, lineTo, bezierCurveTo,
        - # quadraticCurveTo, ellipticalArcTo, arc, arcTo, rect, roundedRect, ellipse,
        - # circle, polygon, commandsToShapes (addSegment/addCubic/addQuadratic/addArc +
        - # endpointToCenterArcParams), computeBounds.
        - # Rasterization (segment/partsition/coverage/fill) lives in src/rasterizer.jl.
        - #
        - # Path failures raise ArgumentError (upstream PixieError; the exception
        - # mapping is fixed by docs/API.md: bad arguments -> ArgumentError).
        - # Coordinates are continuous, 0-based, y-down, Float32 (D011); upstream
        - # rounding (ties away from zero, e.g. `ceil`) uses the module-level
        - # `roundHalfAway` from src/Vetra.jl instead of Base round (ties to even).
        - # Not ported here: Path's `$` string formatter, strokeShapes/strokePath,
        - # fillOverlaps/strokeOverlaps, and the Paint branch of fillPath -- all
        - # belong to later tasks (T005/T007/T010) per the task split.
        - 
        - """Constants shared with the rasterizer (upstream `const epsilon: float32`)."""
        - const PIXIE_EPSILON = Float32(0.0001 * pi)
        - const PI_F = Float32(pi)
        - const TAU_F = 2f0 * PI_F
        - 
        - """
        - Winding rules (upstream `WindingRule`): `NonZero` fills where the winding
        - count is nonzero; `EvenOdd` fills where it is odd (crossing-count parity).
        - """
        - struct WindingRule
        -     value::Int
        - end
        - const NonZero = WindingRule(0)
        - const EvenOdd = WindingRule(1)
        - 
        - """
        - Path command kinds, in upstream `PathCommandKind` order (values 0..18); a
        - command is stored in the flat command buffer as `Float32(kind)` followed by
        - its parameters (all Float32).
        - """
        - @enum PathCommandKind begin
        -     Close
        -     Move
        -     LineTo # upstream `Line` member; renamed: `@enum` consts must not shadow the geometry `Line` type
        -     HLine
        -     VLine
        -     Cubic
        -     SCubic
        -     Quad
        -     TQuad
        -     Arc
        -     RMove
        -     RLine
        -     RHLine
        -     RVLine
        -     RCubic
        -     RSCubic
        -     RQuad
        -     RTQuad
        -     RArc
        - end
        - 
        - # Command buffers store kinds as Float32 (upstream `kind.float32`); this
        - # build's @enum type has no float constructor.
        0 kindFloat(kind::PathCommandKind) = Float32(Int(kind))
        - 
        - """True for the relative command kinds (upstream `isRelative`)."""
        - function isRelative(kind::PathCommandKind)
        -     r = (RMove, RLine, RHLine, RVLine, RCubic, RSCubic, RQuad, RTQuad, RArc)
        -     return any(kind === k for k in r)
        - end
        - 
        - """Number of parameters a command carries (upstream `parameterCount`)."""
        - function parameterCount(kind::PathCommandKind)
        -     kind === Close && return 0
        -     (kind === Move || kind === LineTo || kind === RMove || kind === RLine ||
        -         kind === TQuad || kind === RTQuad) && return 2
        -     (kind === HLine || kind === VLine || kind === RHLine ||
        -         kind === RVLine) && return 1
        -     (kind === Cubic || kind === RCubic) && return 6
        -     (kind === SCubic || kind === RSCubic || kind === Quad ||
        -         kind === RQuad) && return 4
        -     (kind === Arc || kind === RArc) && return 7
        -     # PathCommandKind is a closed enum; every value is covered above.
        -     return 0
        - end
        - 
        - """
        - Mutable path: flat command buffer (each command starts with `Float32(kind)`)
        - plus the current sub-path `start` and `at` points maintained by the command
        - builders (upstream `Path`).
        - """
        - mutable struct Path
        -     commands::Vector{Float32}
        -     start::Vec2
        -     at::Vec2
        - end
        - 
        - """Create a new empty path (upstream `newPath`)."""
        - newPath() = Path(Float32[], Vec2(), Vec2())
        - 
        - """Copy the path's commands and cursor (upstream `copy`)."""
        - Base.copy(path::Path) = Path(copy(path.commands), path.start, path.at)
        - 
        - # --------------------------------------------------------------------------
        - # Command builders
        - # --------------------------------------------------------------------------
        - 
        - """Append `other`'s commands (upstream `addPath`; cursors are untouched)."""
        - function addPath(path::Path, other::Path)
        -     append!(path.commands, other.commands)
        -     return nothing
        - end
        - 
        - """
        - Append a Close command and reset the cursor to the sub-path start
        - (upstream `closePath`; the command is added unconditionally).
        - """
        - function closePath(path::Path)
        -     push!(path.commands, kindFloat(Close))
        -     path.at = path.start
        -     return nothing
        - end
        - 
        - """Begin a new sub-path at (x, y) (upstream `moveTo`)."""
        - function moveTo(path::Path, x::Float32, y::Float32)
        -     push!(path.commands, kindFloat(Move), x, y)
        -     p_ = Vec2(x, y)
        -     path.start = p_
        -     path.at = p_
        -     return nothing
        - end
        - moveTo(path::Path, v::Vec2) = moveTo(path, v.x, v.y)
        - 
        - """Connect the sub-path's last point to (x, y) with a straight line
        - (upstream `lineTo`)."""
        - function lineTo(path::Path, x::Float32, y::Float32)
        -     push!(path.commands, kindFloat(LineTo), x, y)
        -     path.at = Vec2(x, y)
        -     return nothing
        - end
        - lineTo(path::Path, v::Vec2) = lineTo(path, v.x, v.y)
        - 
        - """Append a cubic Bézier segment (upstream `bezierCurveTo`)."""
        - function bezierCurveTo(path::Path, x1::Float32, y1::Float32, x2::Float32, y2::Float32, x3::Float32, y3::Float32)
        -     push!(path.commands, kindFloat(Cubic), x1, y1, x2, y2, x3, y3)
        -     path.at = Vec2(x3, y3)
        -     return nothing
        - end
        - bezierCurveTo(path::Path, c1::Vec2, c2::Vec2, to::Vec2) =
        -     bezierCurveTo(path, c1.x, c1.y, c2.x, c2.y, to.x, to.y)
        - 
        - """Append a quadratic Bézier segment (upstream `quadraticCurveTo`)."""
        - function quadraticCurveTo(path::Path, x1::Float32, y1::Float32, x2::Float32, y2::Float32)
        -     push!(path.commands, kindFloat(Quad), x1, y1, x2, y2)
        -     path.at = Vec2(x2, y2)
        -     return nothing
        - end
        - quadraticCurveTo(path::Path, c::Vec2, to::Vec2) =
        -     quadraticCurveTo(path, c.x, c.y, to.x, to.y)
        - 
        - """
        - Append an elliptical arc (upstream `ellipticalArcTo`): radii, axis rotation
        - in degrees, large-arc and sweep flags, end point.
        - """
        - function ellipticalArcTo(path::Path, rx::Float32, ry::Float32, xAxisRotation::Float32, largeArcFlag::Bool, sweepFlag::Bool, x::Float32, y::Float32)
        -     push!(path.commands, kindFloat(Arc), rx, ry, xAxisRotation,
        -         Float32(largeArcFlag), Float32(sweepFlag), x, y)
        -     path.at = Vec2(x, y)
        -     return nothing
        - end
        - 
        - """
        - Add a circular arc centered at (x, y) from angle a0 to a1 (upstream `arc`).
        - Negative radius raises `ArgumentError`; radius 0 is a no-op.
        - """
        - function arc(path::Path, x::Float32, y::Float32, r::Float32, a0::Float32, a1::Float32; ccw::Bool = false)
        -     if r < 0f0
        -         throw(ArgumentError("Invalid arc, negative radius: $(r)"))
        -     elseif r == 0f0 # radius zero: do nothing
        -         return nothing
        -     end
        -     dx = r * cos(a0)
        -     dy = r * sin(a0)
        -     x0 = x + dx
        -     y0 = y + dy
        -     cw = !ccw
        -     if isempty(path.commands)
        -         moveTo(path, x0, y0)
        -     elseif abs(path.at.x - x0) > PIXIE_EPSILON || abs(path.at.y - y0) > PIXIE_EPSILON
        -         lineTo(path, x0, y0)
        -     end
        -     angle = ccw ? (a0 - a1) : (a1 - a0)
        -     if angle < 0f0
        -         # Going the wrong way: wrap the other way.
        -         # `rem` matches Nim's float `mod` (truncating); Julia's `%` is
        -         # floor-based and would push a -PI/2 wrap to 5PI/2 (full circle).
        -         angle = rem(angle, TAU_F) + TAU_F
        -     end
        -     if angle > TAU_F - PIXIE_EPSILON
        -         # Full circle: two half arcs.
        -         ellipticalArcTo(path, r, r, 0f0, true, cw, x - dx, y - dy)
        -         path.at = Vec2(x0, y0)
        -         ellipticalArcTo(path, r, r, 0f0, true, cw, path.at.x, path.at.y)
        -     elseif angle > PIXIE_EPSILON
        -         px = x + r * cos(a1)
        -         py = y + r * sin(a1)
        -         path.at = Vec2(px, py)
        -         ellipticalArcTo(path, r, r, 0f0, angle >= PI_F, cw, path.at.x, path.at.y)
        -     end
        -     return nothing
        - end
        - arc(path::Path, pos::Vec2, r::Float32, a::Vec2; ccw::Bool = false) =
        -     arc(path, pos.x, pos.y, r, a.x, a.y; ccw = ccw)
        - 
        - """
        - Rounded-corner arc between the (x0,y0)->(x1,y1) and (x1,y1)->(x2,y2)
        - directions with radius r (upstream `arcTo`; negative radius raises
        - `ArgumentError`).
        - """
        - function arcTo(path::Path, x1::Float32, y1::Float32, x2::Float32, y2::Float32, r::Float32)
        -     if r < 0f0
        -         throw(ArgumentError("Invalid arc, negative radius: $(r)"))
        -     end
        -     x0 = path.at.x
        -     y0 = path.at.y
        -     x21 = x2 - x1
        -     y21 = y2 - y1
        -     x01 = x0 - x1
        -     y01 = y0 - y1
        -     l01_2 = x01 * x01 + y01 * y01
        -     if isempty(path.commands)
        -         moveTo(path, x0, y0)
        -     elseif !(l01_2 > PIXIE_EPSILON)
        -         # (x1, y1) coincides with (x0, y0): do nothing.
        -         return nothing
        -     elseif !(abs(y01 * x21 - y21 * x01) > PIXIE_EPSILON) || r == 0f0
        -         lineTo(path, x1, y1)
        -         return nothing
        -     end
        -     x20 = x2 - x0
        -     y20 = y2 - y0
        -     l21_2 = x21 * x21 + y21 * y21
        -     l20_2 = x20 * x20 + y20 * y20
        -     l21 = sqrt(l21_2)
        -     l01 = sqrt(l01_2)
        -     l = r * tan((PI_F - acos((l21_2 + l01_2 - l20_2) / (2 * l21 * l01))) / 2)
        -     t01 = l / l01
        -     t21 = l / l21
        -     if abs(t01 - 1f0) > PIXIE_EPSILON
        -         lineTo(path, x1 + t01 * x01, y1 + t01 * y01)
        -     end
        -     px = x1 + t21 * x21
        -     py = y1 + t21 * y21
        -     path.at = Vec2(px, py)
        -     ellipticalArcTo(path, r, r, 0f0, false, y01 * x20 > x01 * y20, path.at.x, path.at.y)
        -     return nothing
        - end
        - arcTo(path::Path, a::Vec2, b::Vec2, r::Float32) = arcTo(path, a.x, a.y, b.x, b.y, r)
        - 
        - """
        - Add a rectangle with corner (x, y) and size (w, h) (upstream `rect`);
        - `clockwise = false` walks the other way (useful for subtraction under EvenOdd).
        - """
        - function rect(path::Path, x::Float32, y::Float32, w::Float32, h::Float32; clockwise::Bool = true)
        0     if clockwise
        0         moveTo(path, x, y)
        0         lineTo(path, x + w, y)
        0         lineTo(path, x + w, y + h)
        0         lineTo(path, x, y + h)
        -     else
        0         moveTo(path, x, y)
        0         lineTo(path, x, y + h)
        0         lineTo(path, x + w, y + h)
        0         lineTo(path, x + w, y)
        -     end
        0     closePath(path)
        0     return nothing
        - end
        - rect(path::Path, r::Rect; clockwise::Bool = true) =
        -     rect(path, r.x, r.y, r.w, r.h; clockwise = clockwise)
        - 
        - """Bézier circle-approximation constant (upstream `splineCircleK`).
        - Float64, exactly as upstream: the magic offsets are computed in Float64 and
        - narrowed to Float32 at the path-command boundary (see `ellipse`/`roundedRect`).
        - Prematurely rounding this to Float32 shifts control points by 1 ulp and moves
        - anti-aliased stroke pixels by ±1."""
        - const SPLINE_CIRCLE_K = 4.0 * (-1.0 + sqrt(2.0)) / 3
        - 
        - """
        - Add a rounded rectangle with per-corner radii (upstream `roundedRect`);
        - radii clamp to [0, min(w, h) / 2] and all-zero radii fall back to `rect`.
        - """
        - function roundedRect(path::Path, x::Float32, y::Float32, w::Float32, h::Float32, nw::Float32, ne::Float32, se::Float32, sw::Float32; clockwise::Bool = true)
        -     maxRadius = min(w / 2f0, h / 2f0)
        -     nw = max(0f0, min(nw, maxRadius))
        -     ne = max(0f0, min(ne, maxRadius))
        -     se = max(0f0, min(se, maxRadius))
        -     sw = max(0f0, min(sw, maxRadius))
        -     if nw == 0f0 && ne == 0f0 && se == 0f0 && sw == 0f0
        -         rect(path, x, y, w, h; clockwise = clockwise)
        -         return nothing
        -     end
        -     s = SPLINE_CIRCLE_K # Float64 (upstream)
        -     # Upstream: the radius offsets are Float64 (radius * splineCircleK) and
        -     # narrowed to Float32 at the `vec2(...)` boundary; the corner-point sums
        -     # are then Float32 + Float32.
        -     t1 = Vec2(x + nw, y)
        -     t2 = Vec2(x + w - ne, y)
        -     r1 = Vec2(x + w, y + ne)
        -     r2 = Vec2(x + w, y + h - se)
        -     b1 = Vec2(x + w - se, y + h)
        -     b2 = Vec2(x + sw, y + h)
        -     l1 = Vec2(x, y + h - sw)
        -     l2 = Vec2(x, y + nw)
        -     t1h = t1 + Vec2(Float32(-Float64(nw) * s), 0f0)
        -     t2h = t2 + Vec2(Float32(Float64(ne) * s), 0f0)
        -     r1h = r1 + Vec2(0f0, Float32(-Float64(ne) * s))
        -     r2h = r2 + Vec2(0f0, Float32(Float64(se) * s))
        -     b1h = b1 + Vec2(Float32(Float64(se) * s), 0f0)
        -     b2h = b2 + Vec2(Float32(-Float64(sw) * s), 0f0)
        -     l1h = l1 + Vec2(0f0, Float32(Float64(sw) * s))
        -     l2h = l2 + Vec2(0f0, Float32(-Float64(nw) * s))
        -     if clockwise
        -         moveTo(path, t1)
        -         lineTo(path, t2)
        -         bezierCurveTo(path, t2h, r1h, r1)
        -         lineTo(path, r2)
        -         bezierCurveTo(path, r2h, b1h, b1)
        -         lineTo(path, b2)
        -         bezierCurveTo(path, b2h, l1h, l1)
        -         lineTo(path, l2)
        -         bezierCurveTo(path, l2h, t1h, t1)
        -     else
        -         moveTo(path, t1)
        -         bezierCurveTo(path, t1h, l2h, l2)
        -         lineTo(path, l1)
        -         bezierCurveTo(path, l1h, b2h, b2)
        -         lineTo(path, b1)
        -         bezierCurveTo(path, b1h, r2h, r2)
        -         lineTo(path, r1)
        -         bezierCurveTo(path, r1h, t2h, t2)
        -         lineTo(path, t1)
        -     end
        -     closePath(path)
        -     return nothing
        - end
        - roundedRect(path::Path, r::Rect, nw::Float32, ne::Float32, se::Float32, sw::Float32; clockwise::Bool = true) =
        -     roundedRect(path, r.x, r.y, r.w, r.h, nw, ne, se, sw; clockwise = clockwise)
        - 
        - """Add an ellipse centered at (cx, cy), radii (rx, ry): four Bézier segments
        - plus Close (upstream `ellipse`)."""
        - function ellipse(path::Path, cx::Float32, cy::Float32, rx::Float32, ry::Float32)
        -     # Upstream: magicX/magicY are Float64 (splineCircleK * float32 promotes);
        -     # the `cx ± magicX` / `cy ± magicY` sums are Float64, narrowed to Float32
        -     # at the bezierCurveTo call. The plain `cx ± rx` / `cy ± ry` stay Float32.
        -     magicX = SPLINE_CIRCLE_K * Float64(rx)
        -     magicY = SPLINE_CIRCLE_K * Float64(ry)
        -     cx6 = Float64(cx); cy6 = Float64(cy)
        -     moveTo(path, cx + rx, cy)
        -     bezierCurveTo(path, cx + rx, Float32(cy6 + magicY), Float32(cx6 + magicX),
        -         cy + ry, cx, cy + ry)
        -     bezierCurveTo(path, Float32(cx6 - magicX), cy + ry, cx - rx,
        -         Float32(cy6 + magicY), cx - rx, cy)
        -     bezierCurveTo(path, cx - rx, Float32(cy6 - magicY), Float32(cx6 - magicX),
        -         cy - ry, cx, cy - ry)
        -     bezierCurveTo(path, Float32(cx6 + magicX), cy - ry, cx + rx,
        -         Float32(cy6 - magicY), cx + rx, cy)
        -     closePath(path)
        -     return nothing
        - end
        - ellipse(path::Path, c::Vec2, rx::Float32, ry::Float32) = ellipse(path, c.x, c.y, rx, ry)
        - 
        - """Add a circle (upstream `circle`: an ellipse with equal radii)."""
        - circle(path::Path, cx::Float32, cy::Float32, r::Float32) = ellipse(path, cx, cy, r, r)
        - circle(path::Path, c::Circle) = ellipse(path, c.pos.x, c.pos.y, c.radius, c.radius)
        - 
        - """
        - Add a regular n-gon centered at (x, y) with circumradius `size`, vertex 0
        - "north" (upstream `polygon`; `sides <= 2` raises `ArgumentError`).
        - """
        - function polygon(path::Path, x::Float32, y::Float32, size::Float32, sides::Int)
        -     if sides <= 2
        -         throw(ArgumentError("Invalid polygon sides value"))
        -     end
        -     moveTo(path, x + size * sin(0f0), y - size * cos(0f0))
        -     for side in 1:(sides - 1)
        -         lineTo(path,
        -             x + size * sin(Float32(side) * 2f0 * PI_F / Float32(sides)),
        -             y - size * cos(Float32(side) * 2f0 * PI_F / Float32(sides)))
        -     end
        -     closePath(path)
        -     return nothing
        - end
        - polygon(path::Path, pos::Vec2, size::Float32, sides::Int) =
        -     polygon(path, pos.x, pos.y, size, sides)
        - 
        - # --------------------------------------------------------------------------
        - # SVG path parsing
        - # --------------------------------------------------------------------------
        - 
        - """
        - Parse a SVG-style path string (upper- and lowercase forms of
        - M L H V C S Q T A Z) into a Path (upstream `parsePath`); malformed input
        - raises `ArgumentError`.
        - """
        - function parsePath(path::String)
        -     result = newPath()
        -     if isempty(path)
        -         return result
        -     end
        -     # p is the 0-based scan position; p + 1 is the 1-based character.
        -     p = 0
        -     numberStart = 0
        -     armed = false
        -     hitDecimal = false
        -     command = Move # overwritten before first use; any kind parses
        -     numbers = Float32[]
        - 
        -     function finishNumber()
        -         # `numberStart` and `p` stay 0-based, exactly as upstream; only the
        -         # slice is translated: upstream `path[numberStart ..< p]` (0-based,
        -         # exclusive end) -> Julia `path[numberStart+1 : p]` (1-based).
        -         # Upstream's `numberStart > 0` guard also drops a number that starts
        -         # at the very first string character (upstream quirk, preserved).
        -         if numberStart > 0
        -             txt = path[numberStart + 1 : p]
        -             try
        -                 push!(numbers, parse(Float32, txt))
        -             catch
        -                 throw(ArgumentError("Invalid path, parsing parameter failed"))
        -             end
        -         end
        -         numberStart = 0
        -         hitDecimal = false
        -         return nothing
        -     end
        - 
        -     function finishCommand()
        -         finishNumber()
        -         if armed
        -             paramCount = parameterCount(command)
        -             if paramCount == 0
        -                 if !isempty(numbers)
        -                     throw(ArgumentError("Invalid path, unexpected parameters"))
        -                 end
        -                 push!(result.commands, kindFloat(command))
        -             else
        -                 if length(numbers) % paramCount != 0
        -                     throw(ArgumentError("Invalid path, wrong number of parameters"))
        -                 end
        -                 for batch in 0:(length(numbers) ÷ paramCount - 1)
        -                     batch > 0 && (command === Move ? command = LineTo :
        -                         command === RMove && (command = RLine))
        -                     push!(result.commands, kindFloat(command))
        -                     for j in 0:(paramCount - 1)
        -                         push!(result.commands, numbers[batch * paramCount + j + 1])
        -                     end
        -                 end
        -                 empty!(numbers)
        -             end
        -         end
        -         armed = true
        -         return nothing
        -     end
        - 
        -     function expectsArcFlag()
        -         return (command === Arc || command === RArc) && length(numbers) % 7 in (3, 4)
        -     end
        - 
        -     while p < length(path)
        -         c = path[p + 1]
        -         if c == 'm'
        -             finishCommand(); command = RMove
        -         elseif c == 'M'
        -             finishCommand(); command = Move
        -         elseif c == 'l'
        -             finishCommand(); command = RLine
        -         elseif c == 'L'
        -             finishCommand(); command = LineTo
        -         elseif c == 'h'
        -             finishCommand(); command = RHLine
        -         elseif c == 'H'
        -             finishCommand(); command = HLine
        -         elseif c == 'V' || c == 'v'
        -             finishCommand(); command = (c == 'v') ? RVLine : VLine
        -         elseif c == 'c'
        -             finishCommand(); command = RCubic
        -         elseif c == 'C'
        -             finishCommand(); command = Cubic
        -         elseif c == 's'
        -             finishCommand(); command = RSCubic
        -         elseif c == 'S'
        -             finishCommand(); command = SCubic
        -         elseif c == 'q'
        -             finishCommand(); command = RQuad
        -         elseif c == 'Q'
        -             finishCommand(); command = Quad
        -         elseif c == 't'
        -             finishCommand(); command = RTQuad
        -         elseif c == 'T'
        -             finishCommand(); command = TQuad
        -         elseif c == 'a'
        -             finishCommand(); command = RArc
        -         elseif c == 'A'
        -             finishCommand(); command = Arc
        -         elseif c == 'z'
        -             finishCommand(); command = Close
        -         elseif c == 'Z'
        -             finishCommand(); command = Close
        -         elseif c == '-' || c == '+'
        -             # A sign right after an exponent letter belongs to the current
        -             # number; otherwise it starts a new one.
        -             if numberStart > 0 && p >= 1 && path[p] in ('e', 'E')
        -                 # exponent continuation: keep scanning
        -             else
        -                 finishNumber()
        -                 numberStart = p
        -             end
        -         elseif c == '.'
        -             if hitDecimal || expectsArcFlag()
        -                 finishNumber()
