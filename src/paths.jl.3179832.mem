        - """Discretize a cubic Bézier into segments (upstream `addCubic`)."""
        - function addCubic!(shape::Vector{Vec2}, at::Vec2, c1::Vec2, c2::Vec2, to::Vec2, errorMarginSq::Float32)
        0     function compute(t::Float32)
        0         t2 = t * t
        0         t3 = t2 * t
        0         return at * (-t3 + 3t2 - 3t + 1f0) + c1 * (3t3 - 6t2 + 3t) +
        -             c2 * (-3t3 + 3t2) + to * t3
        -     end
        0     function computeDeriv(t::Float32)
        0         t2 = t * t
        0         return at * (-3t2 + 6t - 3f0) + c1 * (9t2 - 12t + 3f0) +
        -             c2 * (-9t2 + 6t) + to * (3 * t2)
        -     end
        -     step = 1f0
        -     t = 0f0
        -     prev = at
        0     next = compute(t + step)
        0     halfway = compute(t + step / 2f0)
        0     while true
        0         step <= eps(Float32) && throw(ArgumentError("Unable to discretize cubic"))
        0         midpoint = (prev + next) / 2f0
        0         lineTangent = midpoint - prev
        0         curveTangent = computeDeriv(t + step / 2f0)
        0         curveTangentScaled = normalize(curveTangent) * length(lineTangent)
        0         error = lengthSq(midpoint - halfway)
        0         errorTangent = lengthSq(lineTangent - curveTangentScaled)
        0         if error + errorTangent > errorMarginSq
        -             next = halfway
        0             halfway = compute(t + step / 4f0)
        0             step = step / 2f0
        -         else
        0             addSegment!(shape, prev, next)
        0             t += step
        0             t == 1f0 && break
        -             prev = next
        0             step = min(step * 2f0, 1f0 - t) # try larger steps optimistically
        0             next = compute(t + step)
        0             halfway = compute(t + step / 2f0)
        -         end
        0     end
        0     return nothing
        - end
        - 
        - """Discretize a quadratic Bézier into segments (upstream `addQuadratic`)."""
        - function addQuadratic!(shape::Vector{Vec2}, at::Vec2, c::Vec2, to::Vec2, errorMarginSq::Float32)
        -     function compute(t::Float32)
        -         t2 = t * t
        -         return at * (t2 - 2t + 1f0) + c * (-2t2 + 2t) + to * t2
        -     end
        -     step = 1f0
        -     t = 0f0
        -     prev = at
        0     next = compute(t + step)
        0     halfway = compute(t + step / 2f0)
        -     halfStepping = false
        0     while true
        0         step <= eps(Float32) && throw(ArgumentError("Unable to discretize quadratic"))
        0         midpoint = (prev + next) / 2f0
        0         error = lengthSq(midpoint - halfway)
        0         if error > errorMarginSq
        -             next = halfway
        0             halfway = compute(t + step / 4f0)
        -             halfStepping = true
        0             step = step / 2f0
        -         else
        0             addSegment!(shape, prev, next)
        0             t += step
        0             t == 1f0 && break
        -             prev = next
        0             if halfStepping
        0                 step = min(step, 1f0 - t)
        -             else
        0                 step = min(step * 2f0, 1f0 - t)
        -             end
        0             next = compute(t + step)
        0             halfway = compute(t + step / 2f0)
        -         end
        0     end
        0     return nothing
        - end
