        - """
        - Apply a matrix transform to a path in place (upstream `transform(path, mat)`):
        - points transform, relative commands keep their deltas (zero translation), arc
        - radii scale by the matrix's x/y scales, and a leading relative move becomes
        - an absolute one.
        - """
        - function transform(path::Path, mat::Mat3)
        -     if mat == mat3()
        -         return nothing
        -     end
        -     if !isempty(path.commands) && path.commands[1] == kindFloat(RMove)
        -         path.commands[1] = kindFloat(Move)
        -     end
        -     i = 1
        -     # Upstream: `mat.pos = vec2(0)` for relative kinds — zero the translation.
        -     lin = Mat3((mat.data[1:6]..., Float32(0), Float32(0), mat.data[9]))
        -     while i <= length(path.commands)
        -         command = PathCommandKind(Int(path.commands[i]))
        -         i += 1
        -         m = isRelative(command) ? lin : mat
        -         if command === Close
        -             # nothing to transform
        -         elseif command === Move || command === LineTo || command === RMove ||
        -             command === RLine || command === TQuad || command === RTQuad
        -             v = m * Vec2(path.commands[i], path.commands[i + 1])
        -             path.commands[i] = v.x
        -             path.commands[i + 1] = v.y
        -         elseif command === HLine || command === RHLine
        -             path.commands[i] = (m * Vec2(path.commands[i], 0f0)).x
        -         elseif command === VLine || command === RVLine
        -             path.commands[i] = (m * Vec2(0f0, path.commands[i])).y
        -         elseif command === Cubic || command === RCubic
        -             c1 = m * Vec2(path.commands[i], path.commands[i + 1])
        -             c2 = m * Vec2(path.commands[i + 2], path.commands[i + 3])
        -             to = m * Vec2(path.commands[i + 4], path.commands[i + 5])
        -             path.commands[i:i + 5] =
        -                 [c1.x, c1.y, c2.x, c2.y, to.x, to.y]
        -         elseif command === SCubic || command === RSCubic ||
        -             command === Quad || command === RQuad
        -             c = m * Vec2(path.commands[i], path.commands[i + 1])
        -             to = m * Vec2(path.commands[i + 2], path.commands[i + 3])
        -             path.commands[i:i + 3] = [c.x, c.y, to.x, to.y]
        -         elseif command === Arc || command === RArc
        -             # Only the scales apply to the radii; the endpoint transforms
        -             # like a point (with the translation zeroed for relative arcs).
        -             r2 = scale(Vec2(mat.data[1], mat.data[5])) *
        -                 Vec2(path.commands[i], path.commands[i + 1])
        -             to = m * Vec2(path.commands[i + 5], path.commands[i + 6])
        -             path.commands[i] = r2.x
        -             path.commands[i + 1] = r2.y
        -             path.commands[i + 5] = to.x
        -             path.commands[i + 6] = to.y
        -         end
        -         i += parameterCount(command)
        -     end
        -     return nothing
        - end
