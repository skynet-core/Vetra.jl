        - """SVG elliptic-arc endpoint -> center parameters
        - (upstream `endpointToCenterArcParams`)."""
        - struct ArcParams
        -     radii::Vec2
        -     rotMat::Mat3
        -     center::Vec2
        -     theta::Float32
        -     delta::Float32
        - end
        - 
        - """Signed angle from u to v (upstream `svgAngle`)."""
        - function svgAngle(u::Vec2, v::Vec2)
        0     a = acos(clamp(dot(u, v) / (length(u) * length(v)), -1f0, 1f0))
        0     if (u.x * v.y - u.y * v.x) < 0f0
        0         a = -a
        -     end
        0     return a
        - end
        - 
        - function endpointToCenterArcParams(at::Vec2, radii::Vec2, rotation::Float32, large::Bool, sweep::Bool, to::Vec2)
        0     radii = Vec2(abs(radii.x), abs(radii.y))
        0     radiiSq = Vec2(radii.x * radii.x, radii.y * radii.y)
        0     radians = rotation / Float32(180) * PI_F
        0     d = Vec2((at.x - to.x) / 2f0, (at.y - to.y) / 2f0)
        0     p = Vec2(
        -         cos(radians) * d.x + sin(radians) * d.y,
        -         -sin(radians) * d.x + cos(radians) * d.y)
        0     pSq = Vec2(p.x * p.x, p.y * p.y)
        0     cr = pSq.x / radiiSq.x + pSq.y / radiiSq.y
        0     if cr > 1f0
        0         radii = radii * sqrt(cr)
        0         radiiSq = Vec2(radii.x * radii.x, radii.y * radii.y)
        -     end
        0     dq = radiiSq.x * pSq.y + radiiSq.y * pSq.x
        0     pq = (radiiSq.x * radiiSq.y - dq) / dq
        0     q = sqrt(max(0f0, pq))
        0     large == sweep && (q = -q)
        0     cp = Vec2(q * radii.x * p.y / radii.y, -q * radii.y * p.x / radii.x)
        0     center = Vec2(
        -         cos(radians) * cp.x - sin(radians) * cp.y + (at.x + to.x) / 2f0,
        -         sin(radians) * cp.x + cos(radians) * cp.y + (at.y + to.y) / 2f0)
        0     theta = svgAngle(Vec2(1f0, 0f0), Vec2((p.x - cp.x) / radii.x, (p.y - cp.y) / radii.y))
        0     delta = svgAngle(
        -         Vec2((p.x - cp.x) / radii.x, (p.y - cp.y) / radii.y),
        -         Vec2((-p.x - cp.x) / radii.x, (-p.y - cp.y) / radii.y))
        0     delta = delta % TAU_F
        0     if sweep && delta < 0f0
        0         delta += TAU_F
        0     elseif !sweep && delta > 0f0
        0         delta -= TAU_F
        -     end
        -     # Normalize delta into (-2PI, 2PI]
        0     while delta > TAU_F
        0         delta -= TAU_F
        -     end
        0     while delta < -TAU_F
        0         delta += TAU_F
        -     end
        0     return ArcParams(radii, rotate(radians), center, theta, delta)
        - end
        - 
        - """Point on a parameterized arc (upstream `arc.compute`)."""
        - function arcPoint(arc::ArcParams, a::Float32)
        -     v = Vec2(cos(a) * arc.radii.x, sin(a) * arc.radii.y)
        -     return arc.rotMat * v + arc.center
        - end
        - 
        - """Discretize an elliptical arc into segments (upstream `addArc`)."""
        - function addArc!(shape::Vector{Vec2}, at::Vec2, radii::Vec2, rotation::Float32, large::Bool, sweep::Bool, to::Vec2, errorMarginSq::Float32)
        0     arc = endpointToCenterArcParams(at, radii, rotation, large, sweep, to)
        -     step = 1f0
        -     t = 0f0
        -     prev = at
        0     while t != 1f0
        0         step <= eps(Float32) && throw(ArgumentError("Unable to discretize arc"))
        0         aPrev = arc.theta + arc.delta * t
        0         a = arc.theta + arc.delta * (t + step)
        0         next = arcPoint(arc, a)
        0         halfway = arcPoint(arc, aPrev + (a - aPrev) / 2f0)
        0         midpoint = (prev + next) / 2f0
        0         error = lengthSq(midpoint - halfway)
        0         if error > errorMarginSq
        0             quarterway = arcPoint(arc, aPrev + (a - aPrev) / 4f0)
        0             halfMid = (prev + halfway) / 2f0
        0             halfwayError = lengthSq(halfMid - quarterway)
        0             if halfwayError < errorMarginSq
        0                 addSegment!(shape, prev, halfway)
        -                 prev = halfway
        0                 t += step / 2f0
        0                 step = min(step / 2f0, 1f0 - t) # next step likely similar
        -             else
        0                 step = step / 4f0 # half step was too big
        -             end
        -         else
        0             addSegment!(shape, prev, next)
        -             prev = next
        0             t += step
        0             step = min(step * 2f0, 1f0 - t)
        -         end
        0     end
        0     return nothing
        - end
