        - # --------------------------------------------------------------------------
        - # Commands -> shapes (polygonal approximation)
        - # --------------------------------------------------------------------------
        - 
        - """Largest scale factor of a transform (upstream `pixelScale`)."""
        - function pixelScale(m::Mat3)
        -     return max(length(Vec2(m[1, 1], m[1, 2])),
        -         length(Vec2(m[2, 1], m[2, 2])))
        - end
        - 
        - const PIXEL_ERROR_MARGIN = Float32(0.2)
        - 
        - """Append one segment, skipping zero-length ones and duplicate adjacent
        - points (upstream `addSegment`)."""
        - function addSegment!(shape::Vector{Vec2}, at::Vec2, to::Vec2)
        -     if at - to != Vec2(0f0, 0f0)
        -         if isempty(shape) || shape[end] != at
        -             push!(shape, at)
        -         end
        -         push!(shape, to)
        -     end
        -     return nothing
        - end
