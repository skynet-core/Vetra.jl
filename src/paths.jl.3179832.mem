        - """
        - Bounding box of the path's (transformed by `mat`) non-horizontal segments
        - (upstream `computeBounds*`); an empty path yields the zero Rect.
        - """
        - function computeBounds(path::Path, mat::Mat3 = mat3())
        -     shapes = commandsToShapes(path, true, pixelScale(mat))
        -     if mat != mat3()
        -         for s in shapes
        -             for k in eachindex(s)
        -                 s[k] = mat * s[k]
        -             end
        -         end
        -     end
        -     segments = shapesToSegments(shapes, false)
        -     return computeBoundsOfSegments(segments)
        - end
